# 配置示例（复制成 .env 或直接设环境变量，不要把真实值提交）

# ---- 出图 ----
LANXI_CKPT=./models/Illustrious-XL.safetensors
LANXI_LORA=./models/lanxi_v1.safetensors
LANXI_CN_DIR=./models/controlnet/openpose
LANXI_POSE=./poses/skel_kneel.png
LANXI_OUT=./output

# ---- 语音 ----
GSV_REPO=./GPT-SoVITS
GSV_PYTHON=./venv/Scripts/python.exe
GSV_SERVICE=./scripts/voice-service.py
GSV_REF_WAV=./refs/ref.wav
GSV_REF_TEXT=参考音频对应的文字（用 Whisper 转写）
FTLANG_CACHE=./langdetect
GSV_PORT=9880

# ---- QQ 官方 Bot（可选，用于把结果发到 QQ）----
QQ_APP_ID=
QQ_APP_SECRET=
QQ_OWNER_OPENID=
